{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS IoT TwinMaker Pricingplan Sync Jobs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sync Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon IoT TwinMaker Get Sync Job",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://iottwinmaker.{region}.amazonaws.com/sync-jobs/:syncSource",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "syncSource",
                "value": "",
                "type": "path",
                "description": "<p>The sync source.</p> <note> <p>Currently the only supported syncSource is <code>SITEWISE </code>.</p> </note>"
              },
              {
                "name": "workspace",
                "value": "",
                "type": "query",
                "description": "The workspace ID."
              }
            ]
          },
          "docs": "Gets the SyncJob."
        }
      ]
    }
  ],
  "bundled": true
}